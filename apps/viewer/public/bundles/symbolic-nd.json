  "gauss4": {
   "name": "4D Gaussian",
   "numDims": 4,
   "dimNames": [
    "x₁",
    "x₂",
    "x₃",
    "x₄"
   ],
   "summary": "one Gaussian with a full 4×4 covariance: every 2D slice an ellipse, every 3D slice an ellipsoid, all tilted",
   "details": "Density ∝ exp(−½ x·Λ·x) with precision matrix Λ = Q diag(1, ½, 2, ¼) Qᵀ for a rotation Q of four Givens angles. The origin (0, 0, 0, 0) is the peak, so every slice through it cuts the ellipsoid through its centre. Λ = [[0.932064,-0.0546893,0.247793,0.378945],[-0.0546893,1.14288,-0.573407,-0.286863],[0.247793,-0.573407,1.10411,0.420946],[0.378945,-0.286863,0.420946,0.570948]]."
  },
  "quad4": {
   "name": "4D indefinite quadratic",
   "numDims": 4,
   "dimNames": [
    "x₁",
    "x₂",
    "x₃",
    "x₄"
   ],
   "summary": "x·A·x with eigenvalues (1, 0.6, −0.8, −1.2) after a rotation: a 4D saddle — slices are bowls, saddles or hyperbolic sheets by the axes chosen",
   "details": "f = x·A·x, A = Q diag(1, 0.6, −0.8, −1.2) Qᵀ. Its level set f = 0 is a cone; a 3D slice through the origin cuts it in a double cone or in nothing, depending on the signature of the restricted form. ∇f = 2Ax is a linear vector field: the origin is a saddle of the gradient flow. A = [[0.394085,0.0661015,0.816918,0.0832983],[0.0661015,-0.486309,0.0452225,0.899364],[0.816918,0.0452225,-0.241117,0.0569875],[0.0832983,0.899364,0.0569875,-0.0666595]]."
  },
  "mix5": {
