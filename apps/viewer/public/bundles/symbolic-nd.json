   "numDims": 5,
   "dimNames": [
    "x₁",
    "x₂",
    "x₃",
    "x₄",
    "x₅"
   ],
   "origin": [
    1.2,
    1,
    -0.6,
    0.5,
    -1
   ],
   "summary": "three isotropic Gaussians of different widths in 5D; the origin sits at the SECOND component's mean, so the default slice cuts through that peak",
   "details": "Σ wᵢ exp(−|x − μᵢ|² / 2σᵢ²) with (w, σ) = (1, 0.9), (0.7, 0.7), (0.5, 0.5). Slices pass through μ₂ = (1.2, 1, -0.6, 0.5, -1); the other peaks lie off most slices and appear as faint tails. Point set: the three means (their shadows on the slice)."
  },
  "rosen5": {
   "name": "5D Rosenbrock",
   "numDims": 5,
   "dimNames": [
    "x₁",
    "x₂",
    "x₃",
    "x₄",
    "x₅"
   ],
   "origin": [
    1,
    1,
    1,
    1,
    1
   ],
   "summary": "Σ 100 (x_{i+1} − x_i²)² + (1 − x_i)², origin at the minimum (1, …, 1): every slice shows the curved valley through it",
   "details": "The chained Rosenbrock function: consecutive axes are coupled, non-consecutive ones only through the chain. A slice along (x₁, x₂) shows the classic banana; along (x₁, x₃) the valley is a parabola-free bowl-like trough; 3D slices show the valley as a tube. Log codomain."
  },
  "waves5": {
   "name": "5D waves",
   "numDims": 5,
   "dimNames": [
    "x₁",
    "x₂",
    "x₃",
    "x₄",
    "x₅"
   ],
   "summary": "Σ sin xᵢ + ½ Σ sin(xᵢ xᵢ₊₁) on [−π, π]⁵: a periodic landscape whose coupling terms bend the ridges",
   "details": "Separable sines give a lattice of maxima, minima and saddles; the products xᵢxᵢ₊₁ inside the second sum couple neighbouring axes, so slices along consecutive axes show bent ridges while (x₁, x₃) slices stay square.",
   "flow": "waves5/neg"
  }
