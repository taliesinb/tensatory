 },
 "fields": {
  "bowl": {
   "kind": "scalar",
   "name": "x² + y²",
   "codomain": "norm",
   "exactGradient": "bowlGrad",
   "data": {
    "type": "symbolic",
    "box": [
     [
      -2,
      2
     ],
     [
      -2,
      2
     ]
    ],
    "expr": {
     "op": "add",
     "vals": [
      {
       "op": "square",
       "val": {
        "op": "coord",
        "index": 0
       }
      },
      {
       "op": "square",
       "val": {
        "op": "coord",
        "index": 1
       }
      }
     ]
    }
   },
   "domain": "plane"
  },
  "bowlGrad": {
   "kind": "vector",
   "name": "∇(x² + y²)",
   "data": {
    "type": "symbolicv",
    "box": [
     [
      -2,
      2
     ],
     [
      -2,
      2
     ]
    ],
    "expr": {
     "op": "compv",
     "coeffs": [
      {
       "op": "mul",
       "vals": [
        2,
        {
         "op": "coord",
         "index": 0
        }
       ]
      },
      {
       "op": "mul",
       "vals": [
        2,
        {
         "op": "coord",
         "index": 1
        }
       ]
      }
     ]
    }
   },
   "domain": "plane"
  },
  "saddle": {
   "kind": "scalar",
   "name": "x² − y²",
