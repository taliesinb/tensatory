        "sigma": 0.7
       },
       {
        "op": "mul",
        "vals": [
         0.6,
         {
          "op": "gaussKernel",
          "val": {
           "op": "norm",
           "vec": {
            "op": "subv",
            "vecs": [
             {
              "op": "coordv"
             },
             {
              "op": "constv",
              "value": [
               1.2,
               1
              ]
             }
            ]
           }
          },
          "mu": 0,
          "sigma": 0.5
         }
        ]
       },
       {
        "op": "mul",
        "vals": [
         0.4,
         {
          "op": "gaussKernel",
          "val": {
           "op": "norm",
           "vec": {
            "op": "subv",
            "vecs": [
             {
              "op": "coordv"
             },
             {
              "op": "constv",
              "value": [
               0.5,
               -1.8
              ]
             }
            ]
           }
          },
          "mu": 0,
          "sigma": 0.4
         }
        ]
       }
      ]
     }
    }
   },
   "domain": "mix"
  },
  "mixtureGradNorm": {
   "kind": "scalar",
   "name": "|∇ mixture|",
   "codomain": "norm",
   "data": {
    "type": "pointwise",
    "expr": {
     "op": "norm",
     "vec": {
      "op": "grad",
      "val": "m"
     }
    },
    "scalars": {
     "m": "mixture"
    }
   },
   "domain": "mix"
  },
  "waves": {
   "kind": "scalar",
   "name": "sin(3x) cos(2y)",
   "codomain": "similarity",
   "data": {
