   "data": {
    "type": "symbolic",
    "box": [
     [
      -2,
      2
     ],
     [
      -2,
      2
     ]
    ],
    "expr": {
     "op": "sub",
     "vals": [
      {
       "op": "square",
       "val": {
        "op": "coord",
        "index": 0
       }
      },
      {
       "op": "square",
       "val": {
        "op": "coord",
        "index": 1
       }
      }
     ]
    }
   }
  },
  "rosenbrock": {
   "kind": "scalar",
   "name": "Rosenbrock",
   "codomain": "log",
   "description": "(a - x)² + b (y - x²)², a = 1, b = 100; log-scaled codomain",
   "data": {
    "type": "symbolic",
    "box": [
     [
      -2,
      2
     ],
     [
      -1,
      3
     ]
    ],
    "consts": {
     "a": 1,
     "b": 100
    },
    "expr": {
     "op": "add",
     "vals": [
      {
       "op": "square",
       "val": {
        "op": "sub",
        "vals": [
         "a",
         {
          "op": "coord",
          "index": 0
         }
        ]
       }
      },
      {
       "op": "mul",
       "vals": [
        "b",
        {
         "op": "square",
         "val": {
          "op": "sub",
          "vals": [
           {
            "op": "coord",
            "index": 1
           },
           {
            "op": "square",
            "val": {
             "op": "coord",
             "index": 0
            }
           }
          ]
         }
        }
       ]
      }
     ]
    }
   },
   "domain": "rosen"
  },
  "rosenbrockGrad": {
